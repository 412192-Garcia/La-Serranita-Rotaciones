# Copiar a .env (en el VPS, en la carpeta de Rotaciones) y completar. El .env no se sube al repo.

# Contraseña de la base (inventá una larga).
DB_PASSWORD=

# Clave para firmar las sesiones: al menos 32 caracteres al azar. Por ejemplo: openssl rand -base64 48
# Si se cambia, todos tienen que volver a entrar.
JWT_SECRET=

# Primer usuario: se crea sólo si no hay ninguno. Después de entrar y cambiar la contraseña, se pueden borrar.
PRIMER_USUARIO=admin
PRIMER_USUARIO_CLAVE=

# Backups de la base (opcional): cuándo (formato cron, por defecto miércoles 4 AM) y cuántos días se guardan.
# BACKUP_CRON=0 4 * * 3
# BACKUP_RETENCION_DIAS=56
